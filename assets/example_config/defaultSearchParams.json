{
    "logging": {
        "debug_console_level": 0,
        "max_message_bytes": 4096
    },
    "global": {
        "q_value_threshold": 0.01
    },
    "search": {
        "n_isotopes": 2
    },
    "acquisition": {
        "nce": 26
    },
    "optimization": {
        "chromatogram_integration": {
            "trace_mode": "combined",
            "deconvolution_solver": "huber"
        },
        "machine_learning": {
            "max_psm_memory_mb": 2000,
            "pep_bin_size": 10
        }
    },
    "proteinScoring": {
        "min_peptides": 1,
        "global_protein_inference": true,
        "write_qc_plots": false
    },
    "maxLFQ": {
        "run_to_run_normalization": false,
        "max_chunk_size_mb": 1024
    },
    "output": {
        "write_csv": true,
        "write_decoys": false,
        "delete_temp": true
    },
    "paths": {
        "library": "/path/to/lib.poin",
        "ms_data": "/path/to/msdata",
        "results": "/path/to/out_dir"
    }
}
