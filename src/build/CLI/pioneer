#!/bin/bash

resolve_script_dir() {
    local script_path="$1"
    while [ -L "$script_path" ]; do
        local script_dir
        script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
        script_path="$(readlink "$script_path")"
        [[ $script_path != /* ]] && script_path="$script_dir/$script_path"
    done
    cd -P "$(dirname "$script_path")" && pwd
}

read_project_version() {
    local project_toml="$1"
    if [ ! -f "$project_toml" ]; then
        return 1
    fi
    sed -nE 's/^version[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' "$project_toml" | head -n1
}

get_pioneer_version() {
    if [ -n "$PIONEER_VERSION" ]; then
        echo "$PIONEER_VERSION"
        return
    fi

    if [ -f "$SCRIPT_DIR/VERSION" ]; then
        head -n1 "$SCRIPT_DIR/VERSION"
        return
    fi

    local project_version=""
    project_version="$(read_project_version "$SCRIPT_DIR/../../../Project.toml")"
    if [ -n "$project_version" ]; then
        echo "$project_version"
        return
    fi

    echo "unknown"
}

SCRIPT_DIR="$(resolve_script_dir "$0")"
PIONEER_VERSION="$(get_pioneer_version)"
PIONEER_SUBAPP_ROOT=""
PIONEER_BUNDLE_SHARE=""
PIONEER_BUNDLE_DEV=""
PIONEER_RUNTIME_DEPOT=""

# Set default threads to auto if not specified
if [ -z "$JULIA_NUM_THREADS" ]; then
    export JULIA_NUM_THREADS=auto
fi

# Valid subcommands
VALID_COMMANDS="search predict params-search params-predict convert-raw convert-mzml"
# empirical params-empirical 

show_help() {
    echo "Pioneer - Mass Spectrometry Data Analysis"
    echo "Version: $PIONEER_VERSION"
    echo ""
    echo "Usage: pioneer [options] <subcommand> [subcommand-args...]"
    echo ""
    echo "Options:"
    echo "  --threads N        Set number of Julia threads (default: auto)"
    echo "  --threads=N        Alternative syntax for setting threads"
    echo "  --help, -h         Show this help message"
    echo "  --version, -V      Show Pioneer version"
    echo ""
    echo "Subcommands:"
    echo "  search <params.json>                        Perform DIA search analysis"
    echo "  predict <params.json>                       Predict spectral library"
    #echo "  empirical <params.json>                     Parse spectral library"
    echo "  params-search <library_path> <ms_data_path> <results_path> [--params-path <params_out_path>]"
    echo "                                              Generate search parameter template."
    echo "                                              Default params output path: ./search_parameters.json"
    echo "  params-predict <library_outpath> <fasta_path> [--params-path <params_out_path>]"
    echo "                                              Generate library build parameter template."
    echo "                                              Default params output path: ./buildspeclib_params.json"
    #echo "  params-empirical <empirical_lib_path> <library_outpath> [--params-path <params_out_path>]"
    #echo "                                              Generate parse parameter template"
    #echo "                                              Default params output path: ./parsespeclib_params.json"
    echo "  convert-raw <data_path> [--output-dir <dir>] [--skip-existing] [--concurrent-files N] [--threads-per-file N]"
    echo "                                              Convert Thermo RAW files via PioneerConverter"
    echo "                                              For additional converter options, run: pioneer convert-raw --help"
    echo "  convert-mzml <data_path> [options]"
    echo "                                              Convert mzML files"
    echo ""
    echo "Examples:"
    echo "  pioneer params-predict yeast.poin fasta/ --params-path predict_params.json"
    echo "  pioneer predict predict_params.json"
    echo "  pioneer params-search yeast.poin data/ results/ --params-path search_params.json"
    echo "  pioneer search search_params.json                                        # Use auto threading"
    echo "  pioneer --threads=8 search search_params.json                            # Use 8 threads"
    echo ""
    echo "For subcommand-specific help:"
    echo "  pioneer <subcommand> --help"
}

show_version() {
    echo "Pioneer version: $PIONEER_VERSION"
}
# Parse command line arguments for thread override
SUBCOMMAND=""
SUBCOMMAND_ARGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --threads)
            if [[ -n "$2" && "$2" != --* ]]; then
                export JULIA_NUM_THREADS="$2"
                shift 2
            else
                echo "Error: --threads requires a value"
                exit 1
            fi
            ;;
        --threads=*)
            export JULIA_NUM_THREADS="${1#*=}"
            shift
            ;;
        --help|-h|-help|/\?)
            if [[ -z "$SUBCOMMAND" ]]; then
                show_help
                exit 0
            else
                SUBCOMMAND_ARGS+=("$1")
                shift
            fi
            ;;
        --version|-V)
            if [[ -z "$SUBCOMMAND" ]]; then
                show_version
                exit 0
            else
                SUBCOMMAND_ARGS+=("$1")
                shift
            fi
            ;;
        -*)
            if [[ -z "$SUBCOMMAND" ]]; then
                echo "Error: Unknown option $1"
                echo "Use --help for usage information"
                exit 1
            else
                SUBCOMMAND_ARGS+=("$1")
                shift
            fi
            ;;
        *)
            # First non-option argument should be the subcommand
            if [[ -z "$SUBCOMMAND" ]]; then
                # Check if it's a valid subcommand
                if [[ " $VALID_COMMANDS " =~ " $1 " ]]; then
                    SUBCOMMAND="$1"
                else
                    echo "Error: Unknown subcommand '$1'"
                    echo "Valid subcommands: $VALID_COMMANDS"
                    echo "Use --help for usage information"
                    exit 1
                fi
            else
                # All remaining arguments go to the subcommand
                SUBCOMMAND_ARGS+=("$1")
            fi
            shift
            ;;
    esac
done

# Auto-set GC threads to half of user threads (mark threads, 1 sweep thread)
if [[ "$JULIA_NUM_THREADS" =~ ^[0-9]+$ ]]; then
    _THREAD_COUNT="$JULIA_NUM_THREADS"
else
    # "auto" or unset — detect CPU count
    if command -v nproc &>/dev/null; then
        _THREAD_COUNT=$(nproc)
    elif command -v sysctl &>/dev/null; then
        _THREAD_COUNT=$(sysctl -n hw.logicalcpu 2>/dev/null || echo 1)
    else
        _THREAD_COUNT=1
    fi
fi
_GC_MARK_THREADS=$(( (_THREAD_COUNT + 1) / 2 ))
if [ "$_GC_MARK_THREADS" -lt 1 ]; then
    _GC_MARK_THREADS=1
fi
export JULIA_NUM_GC_THREADS="${_GC_MARK_THREADS},1"

# Check if subcommand was provided
if [[ -z "$SUBCOMMAND" ]]; then
    echo "Error: Subcommand required"
    echo "Valid subcommands: $VALID_COMMANDS"
    echo "Use --help for usage information"
    exit 1
fi

# Map aliases to the canonical executable names
case "$SUBCOMMAND" in
    search)
        SUBCOMMAND="SearchDIA"
        ;;
    predict)
        SUBCOMMAND="BuildSpecLib"
        ;;
    params-search)
        SUBCOMMAND="GetSearchParams"
        ;;
    params-predict)
        SUBCOMMAND="GetBuildLibParams"
        ;;
    convert-raw)
        SUBCOMMAND="PioneerConverter"
        ;;
    convert-mzml)
        SUBCOMMAND="convertMzML"
        ;;
esac
    #empirical)
    #    SUBCOMMAND="ParseSpecLib"
    #    ;;
    #params-empirical)
    #    SUBCOMMAND="GetParseSpecLibParams"
    #    ;;

resolve_executable_path() {
    local executable_name="$1"

    case "$executable_name" in
        GetSearchParams|GetBuildLibParams|GetParseSpecLibParams)
            if [ -x "$SCRIPT_DIR/apps/params/bin/$executable_name" ]; then
                echo "$SCRIPT_DIR/apps/params/bin/$executable_name"
                return
            fi
            ;;
        BuildSpecLib)
            if [ -x "$SCRIPT_DIR/apps/predict/bin/$executable_name" ]; then
                echo "$SCRIPT_DIR/apps/predict/bin/$executable_name"
                return
            fi
            ;;
        SearchDIA)
            if [ -x "$SCRIPT_DIR/apps/search/bin/$executable_name" ]; then
                echo "$SCRIPT_DIR/apps/search/bin/$executable_name"
                return
            fi
            ;;
        convertMzML)
            if [ -x "$SCRIPT_DIR/apps/convert/bin/$executable_name" ]; then
                echo "$SCRIPT_DIR/apps/convert/bin/$executable_name"
                return
            fi
            ;;
    esac

    if [ -x "$SCRIPT_DIR/apps/runtime/bin/$executable_name" ]; then
        echo "$SCRIPT_DIR/apps/runtime/bin/$executable_name"
        return
    fi

    echo "$SCRIPT_DIR/bin/$executable_name"
}

configure_subapp_runtime_env() {
    local executable_name="$1"
    local subapp_root=""

    case "$executable_name" in
        GetSearchParams|GetBuildLibParams|GetParseSpecLibParams)
            subapp_root="$SCRIPT_DIR/apps/params"
            ;;
        BuildSpecLib)
            subapp_root="$SCRIPT_DIR/apps/predict"
            ;;
        SearchDIA)
            subapp_root="$SCRIPT_DIR/apps/search"
            ;;
        convertMzML)
            subapp_root="$SCRIPT_DIR/apps/convert"
            ;;
    esac

    if [ ! -d "$subapp_root/share/julia" ] && [ "$executable_name" != "PioneerConverter" ] && [ -d "$SCRIPT_DIR/apps/runtime/share/julia" ]; then
        subapp_root="$SCRIPT_DIR/apps/runtime"
    fi

    if [ -d "$subapp_root/share/julia" ]; then
        local bundle_share="$subapp_root/share/julia"
        local bundle_dev="$bundle_share/dev"
        local cache_root=""
        local runtime_depot=""

        case "$(uname -s)" in
            Darwin)
                cache_root="$HOME/Library/Caches/Pioneer/julia"
                ;;
            *)
                if [ -n "$XDG_CACHE_HOME" ]; then
                    cache_root="$XDG_CACHE_HOME/Pioneer/julia"
                else
                    cache_root="$HOME/.cache/Pioneer/julia"
                fi
                ;;
        esac
        runtime_depot="$cache_root/$(basename "$subapp_root")"
        mkdir -p "$runtime_depot"
        PIONEER_SUBAPP_ROOT="$subapp_root"
        PIONEER_BUNDLE_SHARE="$bundle_share"
        PIONEER_BUNDLE_DEV="$bundle_dev"
        PIONEER_RUNTIME_DEPOT="$runtime_depot"

        if [ -n "$JULIA_LOAD_PATH" ]; then
            export JULIA_LOAD_PATH="$bundle_share:$bundle_dev:@stdlib:$JULIA_LOAD_PATH"
        else
            export JULIA_LOAD_PATH="$bundle_share:$bundle_dev:@stdlib"
        fi

        if [ -n "$JULIA_DEPOT_PATH" ]; then
            export JULIA_DEPOT_PATH="$runtime_depot:$bundle_share:$JULIA_DEPOT_PATH"
        else
            export JULIA_DEPOT_PATH="$runtime_depot:$bundle_share"
        fi
    fi
}

configure_runtime_precompile_policy() {
    local executable_name="$1"
    case "$executable_name" in
        BuildSpecLib|SearchDIA)
            export JULIA_PKG_PRECOMPILE_AUTO=0
            ;;
    esac
}

configure_subapp_runtime_env "$SUBCOMMAND"
configure_runtime_precompile_policy "$SUBCOMMAND"
exec "$(resolve_executable_path "$SUBCOMMAND")" "${SUBCOMMAND_ARGS[@]}"
