<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
  xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" 
           Name="Pioneer $(var.DisplayVersion)"
           Language="1033" 
           Version="$(var.ProductVersion)" 
           Manufacturer="$(var.PackageIdentifier)"
           UpgradeCode="$(var.UpgradeCode)">
    
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine"
             Platform="x64" />
    
    <!-- UpgradeCode is deterministic per user-visible Pioneer version. A
         rebuilt package therefore replaces that version, while another
         version has a different family and remains installed side by side. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer build of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Display the project license during installation -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\LICENSE.rtf" />
    
    <!-- Single feature containing all components -->
    <Feature Id="ProductFeature" Title="Pioneer $(var.DisplayVersion)" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="EnvironmentPath" />
      <ComponentRef Id="JuliaDirPermissions" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Pioneer" />
      </Directory>
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="PIONEERROOT" Name="Pioneer">
          <Directory Id="INSTALLFOLDER" Name="$(var.InstallKey)">
            <Directory Id="ShareDir" Name="share">
              <Directory Id="JuliaDir" Name="julia">
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Component Id="JuliaDirPermissions" Guid="$(var.PermissionsComponentGuid)" Win64="yes" Directory="JuliaDir">
      <CreateFolder>
        <util:PermissionEx 
            User="Users" 
            GenericAll="yes" />
      </CreateFolder>
    </Component>
    
    <!-- Start Menu shortcut for the GUI. The exe itself is harvested by
         heat.exe from the install root, so this component owns only the
         shortcut and uses a registry value as its KeyPath. -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="$(var.ShortcutComponentGuid)" Win64="yes">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Pioneer $(var.DisplayVersion)"
                  Description="$(var.ProductDescription)"
                  Target="[INSTALLFOLDER]pioneer-gui.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="Pioneer.ico" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\WashU\GoldfarbLab\Pioneer\$(var.InstallKey)"
                       Name="shortcut"
                       Type="string"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Add installation directory to PATH -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="EnvironmentPath" Guid="$(var.PathComponentGuid)" Win64="yes">
        <Environment Id="PATH" 
                     Name="PATH" 
                     Value="[INSTALLFOLDER]" 
                     Permanent="no" 
                     Part="first"
                     Action="set" 
                     System="yes" />
        <RegistryValue Root="HKLM" 
                       Key="Software\WashU\GoldfarbLab\Pioneer\$(var.InstallKey)"
                       Name="version" 
                       Type="string" 
                       Value="$(var.ProductVersion)" 
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    
    <!-- Minimal UI for silent or basic installation -->
    <UIRef Id="WixUI_Minimal" />
    
    <!-- Product information -->
    <Property Id="ARPCOMMENTS" Value="$(var.ProductDescription)" />
    <Property Id="ARPPRODUCTICON" Value="Pioneer.ico" />
    <Icon Id="Pioneer.ico" SourceFile="$(var.IconIco)" />
  </Product>
  
</Wix>
