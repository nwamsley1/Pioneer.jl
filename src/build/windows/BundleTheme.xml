  The control names are part of WixStandardBootstrapperApplication's contract
  and must not change. Pioneer uses a larger canvas, left-aligned choices, and
  a dedicated 64 px logo so the setup remains balanced at Windows DPI scaling.
-->
<Theme xmlns="http://wixtoolset.org/schemas/thmutil/2010">
  <Window Width="600" Height="440" HexStyle="100a0000" FontId="0">#(loc.Caption)</Window>

  <!-- Theme colors use WiX's BGR byte order. -->
  <!-- Keep native Win32 controls on WiX's stock font metrics. In particular,
       the Install button is redrawn when accepting the license; oversized
       native metrics render unreliably at some Windows display scales. -->
  <Font Id="0" Height="-12" Weight="500" Foreground="33291f" Background="ffffff">Segoe UI</Font>
  <Font Id="1" Height="-25" Weight="600" Foreground="624820">Segoe UI</Font>
  <Font Id="2" Height="-20" Weight="600" Foreground="624820">Segoe UI</Font>
  <Font Id="3" Height="-14" Weight="400" Foreground="33291f" Background="ffffff">Segoe UI</Font>
  <Font Id="4" Height="-14" Weight="400" Foreground="1823b4" Background="ffffff" Underline="yes">Segoe UI</Font>
  <Font Id="5" Height="-13" Weight="400" Foreground="736b5f">Segoe UI</Font>
  <Font Id="6" Height="-14" Weight="600" Foreground="624820">Segoe UI</Font>

  <Image X="30" Y="24" Width="64" Height="64" ImageFile="logo.png" Visible="yes" />
  <Text X="112" Y="28" Width="-30" Height="32" FontId="1" Visible="yes" DisablePrefix="yes">#(loc.Title)</Text>
  <Text X="112" Y="62" Width="-30" Height="22" FontId="5" Visible="yes" DisablePrefix="yes">Fast analysis for DIA proteomics experiments</Text>

  <Page Name="Help">
    <Text X="30" Y="124" Width="-30" Height="28" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Text>
    <Text X="30" Y="166" Width="-30" Height="-84" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Text>
    <Button Name="HelpCancelButton" X="-24" Y="-24" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.HelpCloseButton)</Button>
  </Page>

  <Page Name="Install">
    <Text X="30" Y="124" Width="-30" Height="24" FontId="6" DisablePrefix="yes">License agreement</Text>
    <Richedit Name="EulaRichedit" X="30" Y="154" Width="-30" Height="150" TabStop="yes" FontId="0" HexStyle="0x800000" />
    <Checkbox Name="EulaAcceptCheckbox" X="30" Y="316" Width="-30" Height="22" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
    <Checkbox Name="CreateDesktopShortcut" X="30" Y="348" Width="-30" Height="22" TabStop="yes" FontId="3">Create a desktop shortcut</Checkbox>
    <Button Name="OptionsButton" X="30" Y="-24" Width="108" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.InstallOptionsButton)</Button>
    <Button Name="InstallButton" X="-140" Y="-24" Width="110" Height="23" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
    <Button Name="WelcomeCancelButton" X="-24" Y="-24" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.InstallCloseButton)</Button>
  </Page>

  <Page Name="Options">
    <Text X="30" Y="124" Width="-30" Height="28" FontId="2" DisablePrefix="yes">#(loc.OptionsHeader)</Text>
    <Text X="30" Y="178" Width="-30" Height="22" FontId="3" DisablePrefix="yes">#(loc.OptionsLocationLabel)</Text>
    <Editbox Name="FolderEditbox" X="30" Y="208" Width="-132" Height="28" TabStop="yes" FontId="3" FileSystemAutoComplete="yes" />
    <Button Name="BrowseButton" X="-24" Y="207" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.OptionsBrowseButton)</Button>
    <Button Name="OptionsOkButton" X="-140" Y="-24" Width="110" Height="23" TabStop="yes" FontId="0">#(loc.OptionsOkButton)</Button>
    <Button Name="OptionsCancelButton" X="-24" Y="-24" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.OptionsCancelButton)</Button>
  </Page>

  <Page Name="FilesInUse">
    <Text X="30" Y="124" Width="-30" Height="28" FontId="2" DisablePrefix="yes">#(loc.FilesInUseHeader)</Text>
    <Text X="30" Y="166" Width="-30" Height="44" FontId="3" DisablePrefix="yes">#(loc.FilesInUseLabel)</Text>
    <Text Name="FilesInUseText" X="30" Y="214" Width="-30" Height="84" FontId="3" DisablePrefix="yes" HexStyle="0x0000C000" />
    <Button Name="FilesInUseCloseRadioButton" X="30" Y="310" Width="-30" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes" HexStyle="0x000009">#(loc.FilesInUseCloseRadioButton)</Button>
    <Button Name="FilesInUseDontCloseRadioButton" X="30" Y="340" Width="-30" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes" HexStyle="0x000009">#(loc.FilesInUseDontCloseRadioButton)</Button>
    <Button Name="FilesInUseOkButton" X="-140" Y="-24" Width="110" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FilesInUseOkButton)</Button>
    <Button Name="FilesInUseCancelButton" X="-24" Y="-24" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.FilesInUseCancelButton)</Button>
  </Page>

  <Page Name="Progress">
    <Text X="30" Y="124" Width="-30" Height="28" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Text>
    <Text X="30" Y="180" Width="84" Height="22" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Text>
    <Text Name="OverallProgressPackageText" X="118" Y="180" Width="-30" Height="22" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Text>
    <Progressbar Name="OverallCalculatedProgressbar" X="30" Y="214" Width="-30" Height="18" />
    <Button Name="ProgressCancelButton" X="-24" Y="-24" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
  </Page>

  <Page Name="Modify">
    <Text X="30" Y="124" Width="-30" Height="28" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Text>
    <Text X="30" Y="174" Width="-30" Height="44" FontId="3" DisablePrefix="yes">Repair this installation, or remove this version of Pioneer from your computer.</Text>
    <Button Name="RepairButton" X="-256" Y="-24" Width="110" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
    <Button Name="UninstallButton" X="-140" Y="-24" Width="110" Height="23" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
    <Button Name="ModifyCancelButton" X="-24" Y="-24" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.ModifyCloseButton)</Button>
  </Page>

  <Page Name="Success">
    <Text Name="SuccessHeader" X="30" Y="124" Width="-30" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessHeader)</Text>
    <Text Name="SuccessInstallHeader" X="30" Y="124" Width="-30" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessInstallHeader)</Text>
    <Text Name="SuccessRepairHeader" X="30" Y="124" Width="-30" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessRepairHeader)</Text>
    <Text Name="SuccessUninstallHeader" X="30" Y="124" Width="-30" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessUninstallHeader)</Text>
    <Text X="30" Y="174" Width="-30" Height="28" FontId="3" DisablePrefix="yes">The requested operation completed successfully.</Text>
    <Button Name="LaunchButton" X="-150" Y="-24" Width="126" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">Launch Pioneer</Button>
    <Text Name="SuccessRestartText" X="30" Y="326" Width="-30" Height="44" FontId="3" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessRestartText)</Text>
    <Button Name="SuccessRestartButton" X="-150" Y="-24" Width="126" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
    <Button Name="SuccessCancelButton" X="-24" Y="-24" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.SuccessCloseButton)</Button>
  </Page>

  <Page Name="Failure">
    <Text Name="FailureHeader" X="30" Y="124" Width="-30" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureHeader)</Text>
    <Text Name="FailureInstallHeader" X="30" Y="124" Width="-30" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureInstallHeader)</Text>
    <Text Name="FailureUninstallHeader" X="30" Y="124" Width="-30" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureUninstallHeader)</Text>
    <Text Name="FailureRepairHeader" X="30" Y="124" Width="-30" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureRepairHeader)</Text>
    <Hypertext Name="FailureLogFileLink" X="30" Y="174" Width="-30" Height="48" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
    <Hypertext Name="FailureMessageText" X="30" Y="228" Width="-30" Height="80" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
    <Text Name="FailureRestartText" X="30" Y="326" Width="-30" Height="44" FontId="3" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureRestartText)</Text>
    <Button Name="FailureRestartButton" X="-150" Y="-24" Width="126" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
    <Button Name="FailureCloseButton" X="-24" Y="-24" Width="96" Height="23" TabStop="yes" FontId="0">#(loc.FailureCloseButton)</Button>
  </Page>
</Theme>
