---
import Base from "../layouts/Base.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import { site } from "../site.config";
import { getReleases, formatDate } from "../lib/releases";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { latest } = await getReleases();


// Key features, from the new docs (same list as the README "Features").
const features = [
  {
    title: "Cross-Platform",
    body: "Runs on Linux, macOS, and Windows.",
  },
  {
    title: "Multi-Vendor",
    body: "Supports Thermo Fisher, SCIEX, and Bruker instruments.",
    link: { href: `${site.docsUrl}user_guide/instruments/`, label: "See supported instruments and configurations" },
  },
  {
    title: "GUI",
    body: "Includes a graphical user interface.",
  },
  {
    title: "Fast",
    body: "Searches files many times faster than data acquisition with whole-proteome in silico libraries, even on the latest fast-scanning TOF instruments.",
  },
  {
    title: "Scalable",
    body: "Processes experiments with hundreds to thousands of runs on standard desktop hardware (32–64 GB of RAM).",
  },
  {
    title: "Deep Proteome Coverage",
    body: "Delivers high sensitivity, quantitative precision, and accuracy on diverse benchmark datasets.",
  },
  {
    title: "Regression Testing and FDR Control",
    body: "Maintains a public suite of regression tests across diverse instruments and acquisition schemes. Each tagged release triggers searches on the benchmark datasets, which include entrapment false discovery rate and false transfer rate analyses.",
    link: { href: site.reportsUrl, label: "Browse the benchmarks" },
  },
];
---
<Base>
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-14 sm:px-6 lg:grid-cols-[1fr_1.05fr] lg:pt-20">
    <div>
      <h1 class="max-w-[17ch] text-[2.5rem] font-[680] leading-[1.06] tracking-[-0.025em] text-ink sm:text-[3.4rem]">
        Ultra-fast analysis for bottom-up proteomics
      </h1>
      <p class="mt-6 max-w-[54ch] text-lg leading-relaxed text-muted">
        Pioneer identifies and quantifies precursors and proteins from data-independent
        acquisition (DIA) experiments. Pioneer runs through both a graphical and a command-line interface,
        and it scales to thousands of runs on standard desktop hardware.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href={`${base}/download/`}
          class="inline-flex items-center rounded-lg bg-action px-5 py-3 font-[600] text-action-ink no-underline transition-[filter] hover:brightness-110"
        >
          {latest ? `Download Pioneer ${latest.version}` : "Download Pioneer"}
        </a>
        <a
          href={site.docsUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center rounded-lg px-5 py-3 font-[600] text-ink no-underline shadow-[inset_0_0_0_1.5px_var(--line)] hover:shadow-[inset_0_0_0_1.5px_var(--muted)]"
        >
          Read the documentation
        </a>
      </div>
      {
        latest && (
          <p class="mt-4 text-sm text-muted">
            Released {formatDate(latest.date)} for macOS, Windows, and Linux.
          </p>
        )
      }
    </div>
    <HeroCarousel />
  </section>

  <section class="border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-[650] tracking-tight">Key features</h2>
      <dl class="mt-8 grid gap-x-14 md:grid-cols-2">
        {
          features.map((f) => (
            <div class="border-t border-line py-5">
              <dt class="font-[620] text-ink">{f.title}</dt>
              <dd class="mt-1.5 max-w-[60ch] text-muted">
                {f.body}
                {f.link && (
                  <>
                    {" "}
                    <a class="text-action underline" href={f.link.href}>{f.link.label}</a>.
                  </>
                )}
              </dd>
            </div>
          ))
        }
        <div class="border-t border-line py-5">
          <dt class="font-[620] text-ink">Non-Commercial License</dt>
          <dd class="mt-1.5 max-w-[60ch] text-muted">
            If seeking a commercial license, please contact Washington University's Office of
            Technology Management:
            <a class="text-ink underline" href={`mailto:${site.commercialContact}?subject=Pioneer%20commercial%20license`}>{site.commercialContact}</a>.
            <a class="text-action underline" href={`${base}/license/`}>Read the license</a>.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
    <h2 class="text-2xl font-[650] tracking-tight">Citing Pioneer</h2>
    <p class="mt-4 max-w-[70ch] text-muted">
      {site.paper.authors.join(", ")} "{site.paper.title}." <em>{site.paper.venue}</em> ({site.paper.year}).
      <a class="text-action underline" href={site.paper.url}>doi:{site.paper.doi}</a>
    </p>
  </section>
</Base>
