{
  "comment_purpose": "Offline BuildSpecLib smoke test against the small keap1 FASTA. Run via with_koina_client(SyntheticKoinaClient()) — no network needed. Output is synthetic (deterministic but not biologically meaningful); do NOT use this library for a real search.",
  "fasta_paths": ["./data/fasta/keap1.fasta"],
  "fasta_names": ["HUMAN"],
