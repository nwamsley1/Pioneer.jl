  "fasta_header_regex_proteins": ["^\\w+\\|(?:\\w+(?:-\\d+)?)\\|[^ ]+ (.*?) [^ ]+="],
  "fasta_header_regex_organisms": [" OS=([^ ]+.*?) [^ ]+="],
  "include_contaminants": false,
  "fasta_digest_params": {
    "min_length": 7,
    "max_length": 30,
    "min_charge": 2,
